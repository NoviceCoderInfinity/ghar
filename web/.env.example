# ---- Browser build vars (REACT_APP_*). These are baked into the public JS
# bundle — NEVER put an API key in a REACT_APP_ variable.

# URL of the FastAPI generation server (server/). Local: http://localhost:8000
REACT_APP_SERVER_URL=http://localhost:8000

# Where the browser fetches its short-lived Live API token.
# Leave unset on Vercel (defaults to the /api/live-token function).
# Local `npm start` has no /api, so use the FastAPI server's endpoint:
REACT_APP_TOKEN_URL=http://localhost:8000/api/live-token

# ---- Server-side only (Vercel function web/api/live-token.mjs).
# Set these in the Vercel dashboard, not in a local web/.env.
# GEMINI_API_KEY=
# ALLOWED_ORIGINS=https://your-app.vercel.app
